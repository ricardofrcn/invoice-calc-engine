{
  "name": "invoice-calc-engine",
  "version": "0.1.0",
  "description": "Moteur de génération de factures à champs calculés : parseur de formules, graphe de dépendances, détection de cycles, tri topologique et recalcul incrémental. Développé en TypeScript.",
  "type": "module",
  "main": "dist/engine/index.js",
  "types": "dist/engine/index.d.ts",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ricardofrcn/invoice-calc-engine.git"
  },
  "keywords": [
    "typescript",
    "dependency-graph",
    "topological-sort",
    "formula-parser",
    "invoice"
  ],
  "author": "Ricardo Forcina",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ricardofrcn/invoice-calc-engine/issues"
  },
  "homepage": "https://github.com/ricardofrcn/invoice-calc-engine#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.3",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.7",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
